doctype html
html
    head
        title= `${title}`
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="stylesheet", href="/css/style.css")
    body
        a(href="/update-cobj") Add to this table
        h1 Books
        table
            thead
                tr
                    th Name
                    th Author
                    th Genre
            tbody
                each book in data
                    tr
                        td #{book.properties.name}
                        td #{book.properties.author}
                        td #{book.properties.genre}
